// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

enum Category {
  CONFERENCE
  WORKSHOP
  SEMINAR
  CONCERT
  SPORTS
  TECHNICAL
  OTHER
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RegistrationMode {
  OPEN
  APPROVAL_REQUIRED
}

enum EventType {
  PUBLIC
  PRIVATE
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FieldType {
  TEXT
  NUMBER
  EMAIL
  PHONE
  URL
  DATE
  SELECT
  CHECKBOX
  TEXTAREA
}

model User {
  id       String @id @default(uuid()) @db.VarChar(36)
  name     String
  email    String @unique
  password String
  role     Role   @default(USER)

  events        Event[]
  registrations Registration[]

  changeRequests EventChangeRequest[] @relation("ChangeRequestOrganizer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Venue {
  id       String @id @default(uuid()) @db.VarChar(36)
  name     String
  location String
  capacity Int

  bookings Booking[]

  changeRequests EventChangeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String @id @default(uuid()) @db.VarChar(36)
  title       String
  description String

  startTime DateTime
  endTime   DateTime

  category Category
  type     EventType

  registrationMode RegistrationMode
  maxParticipants  Int?

  status EventStatus @default(PENDING)

  organizerId String
  organizer   User   @relation(fields: [organizerId], references: [id])

  booking            Booking?
  registrations      Registration[]
  registrationFields RegistrationField[]

  changeRequests EventChangeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id String @id @default(uuid()) @db.VarChar(36)

  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id])

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  startTime DateTime
  endTime   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Registration {
  id String @id @default(uuid()) @db.VarChar(36)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  status  RegistrationStatus   @default(PENDING)
  answers RegistrationAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId])
}

model RegistrationField {
  id String @id @default(uuid()) @db.VarChar(36)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  label       String
  fieldType   FieldType
  required    Boolean   @default(false)
  placeholder String?
  options     Json?
  order       Int

  answers RegistrationAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegistrationAnswer {
  id String @id @default(uuid()) @db.VarChar(36)

  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  fieldId String
  field   RegistrationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([registrationId, fieldId])
}

model EventChangeRequest {
  id String @id @default(uuid()) @db.VarChar(36)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  requestedById String
  requestedBy   User   @relation("ChangeRequestOrganizer", fields: [requestedById], references: [id])

  requestedStartTime DateTime
  requestedEndTime   DateTime

  requestedVenueId String
  requestedVenue   Venue  @relation(fields: [requestedVenueId], references: [id])

  reason String?

  status ChangeRequestStatus @default(PENDING)

  reviewedById  String?
  reviewedAt    DateTime?
  reviewComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
